{
    "name": "chart-kit",
    "version": "0.0.0",
    "private": true,
    "description": "Reusable, theme-aware React chart components (Highcharts + Recharts).",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/chart-kit.js",
    "module": "./dist/chart-kit.js",
    "exports": {
        ".": "./dist/chart-kit.js",
        "./style.css": "./dist/chart-kit.css"
    },
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "build": "vite build",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "format": "prettier --write \"**/*.{js,jsx,json,css,md}\""
    },
    "peerDependencies": {
        "highcharts": "^12.6.0",
        "highcharts-react-official": "^3.2.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "recharts": "^3.3.0"
    },
    "devDependencies": {
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@vitejs/plugin-react": "^5.2.0",
        "highcharts": "^12.6.2",
        "highcharts-react-official": "^3.2.3",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "recharts": "^3.10.1",
        "storybook": "^10.6.1",
        "vite": "^7.3.6"
    }
}
