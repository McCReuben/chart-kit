{
    "name": "chart-kit",
    "version": "0.0.0",
    "private": true,
    "description": "Reusable, theme-aware React chart components built on Recharts.",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/chart-kit.js",
    "module": "./dist/chart-kit.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/chart-kit.js"
        },
        "./style.css": "./dist/chart-kit.css"
    },
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
        "check:no-highcharts": "node scripts/check-no-highcharts.mjs",
        "screenshots": "python3 scripts/screenshot.py",
        "typecheck": "tsc -p tsconfig.json",
        "verify": "npm run typecheck && npm test && npm run build && npm run check:no-highcharts && npm run build-storybook",
        "test": "vitest run"
    },
    "peerDependencies": {
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "recharts": "^3.3.0"
    },
    "devDependencies": {
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@testing-library/react": "^16.3.3",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "highcharts": "^12.6.2",
        "highcharts-react-official": "^3.2.3",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "recharts": "^3.10.1",
        "storybook": "^10.6.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vitest": "^3.2.7"
    },
    "types": "./dist/types/index.d.ts"
}
